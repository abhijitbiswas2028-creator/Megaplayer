# MEGA STREAM X Configuration
PORT=3000
NODE_ENV=development

# 32-byte cryptographic secret used for AES-256-GCM encryption of MEGA references at rest
MEGA_ENCRYPTION_KEY=mega_stream_x_master_aes256_gcm_secret_key_change_in_production!

# MongoDB connection URI (e.g. MongoDB Atlas cluster or local mongodb://)
# Set privately in Railway Variables / environment; never prefix this value with VITE_.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/megaplayer?retryWrites=true&w=majority
MONGODB_DATABASE=megaplayer
